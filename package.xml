<?xml version="1.0"?>
<package format="2">
  <name>hero_chassis_controller</name>
  <version>0.1.0</version>
  <description>Mecanum wheel hero robot chassis controller based on ros_control.</description>
  <maintainer email="2465308638@qq.com">Qiuweiling</maintainer>
  <license>BSD</license>
  <author email="2465308638@qq.com">Qiuweiling</author>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>boost</build_depend>
  <depend>eigen</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>geometry_msgs</depend>
  <depend>realtime_tools</depend>

  <build_depend>roslint</build_depend>
  <export>
    <controller_interface plugin="${prefix}/hero_chassis_controller_plugins.xml"/>
  </export>
</package>
